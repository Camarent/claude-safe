#!/bin/sh
# generated by tools/cmdindex.py gen-bin from paths.json; do not edit
here=$(dirname "$(readlink -f "$0")")
target="$here/../tools/ux_shots.js"
if [ ! -f "$target" ]; then
  echo "cs-ux-shots: target missing: $target (fix paths.json, run tools/cmdindex.py gen-bin)" >&2
  exit 2
fi
exec node "$target" "$@"

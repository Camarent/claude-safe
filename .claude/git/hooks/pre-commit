#!/bin/sh
BAD='unirect'
if printf '%s %s' "$(git var GIT_AUTHOR_IDENT)" "$(git var GIT_COMMITTER_IDENT)" | grep -qi "$BAD"; then
  echo "pre-commit: personal email in author/committer identity; use Camarent noreply" >&2; exit 1
fi
if git diff --cached -U0 | grep '^+' | grep -v '^+++' | grep -qi "$BAD"; then
  echo "pre-commit: staged content contains the personal address" >&2; exit 1
fi

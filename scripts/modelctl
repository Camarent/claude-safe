#!/usr/bin/env bash
# modelctl: start and stop the local model servers inside this container, one at a time on the GPU.
# Mounted by run.sh at /usr/local/bin/modelctl (no image rebuild needed to change it).
#
#   modelctl status                          what runs, GPU memory
#   modelctl use strata|ollama|none          the GPU mode switch: stop the others, start this one, wait until it answers
#   modelctl strata start [--model M] [--family F] [--context C] [--vision V] [--coexist]
#   modelctl strata stop
#   modelctl ollama start [--kv q8_0|f16|q4_0] [--coexist]
#   modelctl ollama stop
#   modelctl ollama load NAME GGUF [CTX]     create NAME from /models/GGUF (context CTX, default 17000) and load it; "ollama create"+run
#   modelctl ollama unload NAME
#   modelctl stop                            stop everything
#
# Without --coexist, starting one engine while the other holds the GPU is refused (use `use`, or stop the other first).
# Strata needs the `strata` profile (its settings come from the same variables as run.sh: STRATA_FAMILY, STRATA_MODEL, ...),
# Ollama the `ollama` profile. Endpoints inside the container: Strata http://127.0.0.1:8080 (key in $STRATA_KEY / $API_KEY),
# Ollama http://127.0.0.1:11434.
set -uo pipefail

STRATA_ENTRY=/opt/strata/entrypoint.sh
STRATA_PORT="${PORT:-8080}"
OLLAMA_URL="http://${OLLAMA_HOST:-127.0.0.1:11434}"
STRATA_LOG=/data/strata.log
OLLAMA_LOG=/tmp/ollama.log
stateDir=/tmp/modelctl; mkdir -p "$stateDir"

say()  { printf '%s\n' "$*"; }
warn() { printf '\033[33m%s\033[0m\n' "$*" >&2; }
die()  { printf '\033[31m%s\033[0m\n' "$*" >&2; exit "${2:-1}"; }

strata_pids() { pgrep -f "$STRATA_ENTRY" || true; }
strata_up() { # is the API answering (key from the environment)
    curl -fsS -m 3 -H "Authorization: Bearer ${STRATA_KEY:-${API_KEY:-}}" "http://127.0.0.1:$STRATA_PORT/v1/models" >/dev/null 2>&1
}
strata_engine_up() { # the engine itself (not the entrypoint script that watches it)
    HOME=/data/home strata launch --status --output json 2>/dev/null | grep -Eq '"state": *"(ready|starting|loading)"'
}
ollama_pids() { pgrep -x -f "ollama serve" || true; }
ollama_up() { curl -fsS -m 3 "$OLLAMA_URL/api/version" >/dev/null 2>&1; }
vram_used() { nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ' || true; }

wait_gone() { # description, check-function, seconds
    local i=0
    while [[ -n "$($2)" ]] && (( i < $3 )); do sleep 1; i=$((i+1)); done
    [[ -z "$($2)" ]] || die "$1 did not stop within $3 s."
}

strata_stop() {
    local p; p="$(strata_pids)"
    [[ -n "$p" ]] || { say "strata: not running"; return 0; }
    say "strata: stopping (its own shutdown can take up to 2 minutes)..."
    # shellcheck disable=SC2086
    kill -TERM $p 2>/dev/null || true         # the entrypoint traps TERM and runs `strata launch --stop`
    wait_gone strata strata_pids 120
    # The engine is its own process, started by `strata launch`; the entrypoint only watches it. Make sure it is really gone
    # (ask the engine to stop again if not) and that the GPU memory came back, because the next engine needs it.
    local i=0
    while strata_engine_up && (( i < 60 )); do
        (( i == 0 )) && HOME=/data/home strata launch --stop --preset "${PRESET:-docker}" >/dev/null 2>&1
        sleep 1; i=$((i+1))
    done
    strata_engine_up && die "strata engine is still running after its stop (strata launch --status). Check $STRATA_LOG."
    say "strata: stopped ($(vram_used) MiB VRAM used)"
}

strata_start() {
    local model="${STRATA_MODEL:-${MODEL:-IQ3_XXS}}" family="${STRATA_FAMILY:-${FAMILY:-qwen}}" context="${STRATA_CONTEXT:-${CONTEXT:-128k}}" vision="${STRATA_VISION:-${VISION:-off}}" coexist=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --model) model="$2"; shift 2 ;; --family) family="$2"; shift 2 ;; --context) context="$2"; shift 2 ;;
            --vision) vision="$2"; shift 2 ;; --coexist) coexist=1; shift ;;
            *) die "strata start: unknown option $1" ;;
        esac
    done
    [[ -x $STRATA_ENTRY ]] || die "Strata is not in this image: start claude-safe with --with strata."
    # One start at a time: two pipeline runs (or a run and a person) calling this together must not launch it twice.
    exec 9>"$stateDir/strata.lock"; flock 9
    if [[ -n "$(strata_pids)" ]]; then
        # Already running (maybe still loading): not an error and not restarted; just wait until it answers.
        say "strata: already running, waiting until it answers (to change the model, stop it first)"
        strata_wait; return $?
    fi
    [[ -n "${API_KEY:-}" ]] || die "No API_KEY in the environment: this container was not started with --with strata."
    if [[ -n "$(ollama_pids)" && $coexist == 0 ]]; then die "ollama holds the GPU. Use 'modelctl use strata', or --coexist (needs the VRAM)."; fi
    mkdir -p /data/home
    say "strata: starting $family / $model, context $context (log: $STRATA_LOG)"
    ( cd /data && HOME=/data/home FAMILY="$family" MODEL="$model" CONTEXT="$context" VISION="$vision" \
        setsid nohup "$STRATA_ENTRY" run >"$STRATA_LOG" 2>&1 < /dev/null & )
    strata_wait || return 1
    say "strata: ready on http://127.0.0.1:$STRATA_PORT ($(vram_used) MiB VRAM used)"
}

strata_wait() { # until the API answers; fails if the entrypoint dies or 15 minutes pass (a first start downloads the model)
    local i=0
    until strata_up; do
        [[ -n "$(strata_pids)" ]] || die "strata exited while starting. Last log lines: $(tail -n 5 "$STRATA_LOG" 2>/dev/null)"
        (( i++ > 900 )) && die "strata did not answer within 15 minutes; see $STRATA_LOG"
        sleep 1
    done
    say "strata: ready"
}

ollama_stop() {
    local p; p="$(ollama_pids)"
    [[ -n "$p" ]] || { say "ollama: not running"; return 0; }
    # shellcheck disable=SC2086
    kill -TERM $p 2>/dev/null || true
    wait_gone ollama ollama_pids 30
    say "ollama: stopped"
}

ollama_start() {
    local kv=q8_0 coexist=0
    while [[ $# -gt 0 ]]; do
        case "$1" in --kv) kv="$2"; shift 2 ;; --coexist) coexist=1; shift ;; *) die "ollama start: unknown option $1" ;; esac
    done
    command -v ollama >/dev/null || die "Ollama is not in this image: start claude-safe with --with ollama."
    [[ -n "$(ollama_pids)" ]] && { say "ollama: already running"; return 0; }
    if [[ -n "$(strata_pids)" && $coexist == 0 ]]; then die "strata holds the GPU. Use 'modelctl use ollama', or --coexist (needs the VRAM)."; fi
    mkdir -p "${OLLAMA_MODELS:-/ollama-data/models}"
    say "ollama: starting (KV cache $kv, log: $OLLAMA_LOG)"
    ( OLLAMA_KV_CACHE_TYPE="$kv" setsid nohup ollama serve >"$OLLAMA_LOG" 2>&1 < /dev/null & )
    local i=0
    until ollama_up; do
        [[ -n "$(ollama_pids)" ]] || die "ollama exited while starting. Last log lines: $(tail -n 5 "$OLLAMA_LOG" 2>/dev/null)"
        (( i++ > 60 )) && die "ollama did not answer within 60 s; see $OLLAMA_LOG"
        sleep 1
    done
    say "ollama: ready on $OLLAMA_URL"
}

ollama_load() { # name gguf [ctx]
    [[ $# -ge 2 ]] || die "usage: modelctl ollama load NAME GGUF [CTX]"
    local name="$1" gguf="$2" ctx="${3:-17000}" mf
    [[ -f "/models/$gguf" ]] || die "/models/$gguf not found (run.sh mounts ~/kata-models, or KATA_MODELS, at /models)."
    ollama_up || die "ollama is not running: modelctl ollama start"
    mf="$(mktemp "$stateDir/Modelfile.XXXXXX")"
    printf 'FROM /models/%s\nPARAMETER num_ctx %s\n' "$gguf" "$ctx" > "$mf"
    ollama create "$name" -f "$mf" >/dev/null || { rm -f "$mf"; die "ollama create $name failed"; }
    rm -f "$mf"
    curl -fsS -m 600 "$OLLAMA_URL/api/generate" -d "{\"model\":\"$name\",\"prompt\":\"\",\"keep_alive\":-1}" >/dev/null || die "could not load $name"
    say "ollama: $name loaded ($(vram_used) MiB VRAM used)"
}

status() {
    if [[ -n "$(strata_pids)" ]]; then if strata_up; then say "strata:  ready (port $STRATA_PORT)"; else say "strata:  starting or unhealthy (tail $STRATA_LOG)"; fi; else say "strata:  stopped"; fi
    if [[ -n "$(ollama_pids)" ]]; then
        if ollama_up; then say "ollama:  ready ($(ollama ps 2>/dev/null | tail -n +2 | awk '{print $1}' | paste -sd, - | sed 's/^$/no model loaded/'))"; else say "ollama:  starting"; fi
    else say "ollama:  stopped"; fi
    local v; v="$(vram_used)"; [[ -n "$v" ]] && say "GPU:     ${v} MiB used"
    return 0
}

use() {
    case "${1:-}" in
        strata) ollama_stop; shift; strata_start "$@" ;;
        ollama) strata_stop; shift; ollama_start "$@" ;;
        none)   strata_stop; ollama_stop ;;
        *) die "usage: modelctl use strata|ollama|none" ;;
    esac
}

cmd="${1:-status}"; [[ $# -gt 0 ]] && shift
case "$cmd" in
    status) status ;;
    use) use "$@" ;;
    stop) strata_stop; ollama_stop ;;
    strata) sub="${1:-}"; [[ $# -gt 0 ]] && shift
        case "$sub" in start) strata_start "$@" ;; stop) strata_stop ;; *) die "usage: modelctl strata start|stop" ;; esac ;;
    ollama) sub="${1:-}"; [[ $# -gt 0 ]] && shift
        case "$sub" in
            start) ollama_start "$@" ;; stop) ollama_stop ;; load) ollama_load "$@" ;;
            unload) [[ $# -ge 1 ]] || die "usage: modelctl ollama unload NAME"; ollama stop "$1" ;;
            *) die "usage: modelctl ollama start|stop|load|unload" ;;
        esac ;;
    -h|--help|help) sed -n '2,/^set -uo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$cmd' (modelctl help)" ;;
esac
